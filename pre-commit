#!/bin/bash

main() {
  init

  # Check that we're not committing directly into the default branch by mistake.
  # Also check that we're not committing into a branch that has been deleted on the
  # remote (i.e. after just merging a PR from this branch).
  check_branch
  
  # Get the list of staged files once, to save invoking the same command over and over again.
  get_staged_files
  
  # Check for "n o c o m m i t" comments. (I am trying to avoid having the actual word in this script, so that
  # if I copy this script to a repo, and I search for that word in my project, I don't get 12 hits from this file).
  check_for_no_commit
  
  # Check rust files for `todo!()`
  check_for_rust_todo

  # How to add custom pre-commit logic in your repo:
  #
  # Rather than editing your copy of this file, you can place any custom
  # pre-commit logic for your repo in .git/hooks/pre-commit-extras.
  #
  # The file will be sourced, so the global variables in this
  # file ($STAGED_FILES etc) will be available.
  #
  # Sample pre-commit-extras file:
  #
  # my_extra_hook() {
  #  local staged_file
  #  while read -r staged_file; do
  #    ... your logic here
  #  done < "$STAGED_FILES"
  # }
  #
  # To indicate failure, simply append to the $FAIL_MSGS variable, like this:
  # FAIL_MSGS="${FAIL_MSGS}❌ This is a helpful error message\n"
  run_extra_hooks

  go_no_go
}

init() {
  # Redirect all subsequent stdout to stderr.
  exec 1>&2

  # Git hooks are run from the root of the repo (no matter where you're running the command from).
  # Sanity check:
  local git_dir
  git_dir=$(git rev-parse --git-common-dir 2>/dev/null)
  if [[ ! -d "$git_dir" ]]; then
    echo "pre-commit: Git directory not found; not being run from a git repo?"
    exit 1
  fi

  HOOK_DIR="$git_dir/hooks"
  STAGED_FILES=/tmp/git-staged.$$
  RENAMED_FILES=/tmp/git-renamed.$$
  PASS_MSGS=
  FAIL_MSGS=

  # This bit of magic is needed so that the script works even in brand new repos, with no previous commits.
  if git rev-parse --verify HEAD > /dev/null 2>&1; then
    AGAINST=HEAD
  else
    # Initial commit: diff against an empty tree object
    # (This is a special value, not random. It's the SHA of the empty-tree).
    AGAINST=4b825dc642cb6eb9a060e54bf8d69288fbee4904
  fi

  # If any command in a pipeline fails, that return code will be used as the return code of the whole pipeline
  set -o pipefail
}

check_branch() {
  local branch
  branch=$(git rev-parse --abbrev-ref $AGAINST) || die failed to determine branch

  check_default_branch "$branch"
  check_deleted_branch "$branch"
}

# Check that we're not committing directly into the default branch by mistake.
check_default_branch() {
  local branch=$1 default_branch
  [[ -e "$HOOK_DIR/.commit_to_default_ok" ]] && return

  default_branch=$(git remote show origin | sed -n '/HEAD branch/s/.*: //p')

  if [[ "$branch" == "$default_branch" ]]; then
    FAIL_MSGS="${FAIL_MSGS}❌ Don't commit directly to the '$default_branch' branch.\n"
    #FAIL_MSGS="${FAIL_MSGS}   If you really intend to commit to the default branch, you can\n"
    #FAIL_MSGS="${FAIL_MSGS}   To disable this: touch .git/hooks/.commit_to_default_ok\n"
  else
    PASS_MSGS="${PASS_MSGS}✅ branch is not the default branch.\n"
  fi
}

# Check that we're not committing into a branch that has been deleted on the remote (i.e. after just merging a PR
# from this branch).
check_deleted_branch() {
  local branch=$1 fetch_head

  fetch_head="$(git rev-parse --git-common-dir)/FETCH_HEAD" || die "Failed to determine fetch_head"
  [[ -e "$HOOK_DIR/.commit_to_deleted_branch_ok" ]] && return

  # Git fetch isn't free, so only do it if there hasn't been a fetch in the last 5 minutes
  if [[ ! -f "$fetch_head" ]] || find "$fetch_head" -mmin +5 | grep -q .; then
    git fetch --prune --quiet
  fi
  if git branch -vv | grep '^[*].*: gone]' > /dev/null; then
    FAIL_MSGS="${FAIL_MSGS}❌ Looks like you have already merged a PR from this branch.\n"
    FAIL_MSGS="${FAIL_MSGS}   (You are commiting into a branch that has been deleted in the remote).\n"
    #FAIL_MSGS="${FAIL_MSGS}   To disable this check: touch .git/hooks/.commit_to_deleted_branch_ok\n"
  fi
}

# Get the list of staged files once, to save invoking the same command over and over again.
get_staged_files() {
  # Use --name-status rather than --name-only so we can omit renamed and deleted files.
  # Redirect to a tmp file rather than store the output in a variable. This way we can handle filenames with spaces.
  grep -v '^D' <(git diff --cached --name-status ${AGAINST}) | sed -e 's/^.*\t//' > "$STAGED_FILES"
  grep '^R'    <(git diff --cached --name-status ${AGAINST}) | sed -e "s/^R[0-9a-f]*\t//; s/\t/:::/" > "$RENAMED_FILES"

  trap 'cleanup' EXIT INT TERM
}

# Check for "n o c o m m i t" comments (I am trying to avoid having the actual word in this script, so that
# if I copy this script to a repo, and I search for that word in my project, I don't get 12 hits from this file).
# Extremely useful for ensuring that you remove temporary debugging junk that you
# don't want to commit!
#
# TODO jafischer-2024-02-26: assumes stock git diff output; doesn't work if you're using something like
#                            "difftool" for prettier git diffs.
check_for_no_commit() {
  local staged_file renamed_line found=false special_word="no"
  #
  special_word="${special_word}commit"
  while read -r staged_file; do
    # Skip this script, obviously.
    [[ $(basename "$staged_file") == pre-commit ]] && continue
    [[ $(basename "$staged_file") == *nocommit* ]] && {
        FAIL_MSGS="${FAIL_MSGS}❌ $staged_file has $special_word in its name.\n"
        found=true
      }
    git diff --staged "$staged_file" 2> /dev/null \
      | grep -v '^[-]' \
      | grep -i "^[+].*$special_word" > /dev/null \
      && {
        FAIL_MSGS="${FAIL_MSGS}❌ $staged_file has a $special_word comment.\n"
        found=true
      }
    done < "$STAGED_FILES"

  while read -r renamed_line; do
    local old_name=${renamed_line/:::*} new_name=${renamed_line/*:::}
    # Skip this script, obviously.
    [[ $(basename "$new_name") == pre-commit ]] && continue

    # For renamed files, we only want to look at the changes, not the entire file; so diff the old and the new.
    git diff HEAD^ HEAD -M -- "$old_name" "$new_name" 2> /dev/null \
      | grep -i "^[+].*$special_word" > /dev/null \
      && {
        FAIL_MSGS="${FAIL_MSGS}❌ $new_name has a $special_word comment.\n"
        found=true
      }
  done < "$RENAMED_FILES"

  if ! $found; then
    PASS_MSGS="${PASS_MSGS}✅ No '$special_word' comments.\n"
  fi
}

check_for_rust_todo() {
  local staged_file todo_found rust_found

  while read -r staged_file; do
    if [[ "$staged_file" == *".rs" ]]; then
      rust_found=1
      git diff --staged "$staged_file" \
        | grep -v '^[-]' \
        | grep -E '\<todo\>!\(\)' > /dev/null \
        && {
          FAIL_MSGS="${FAIL_MSGS}❌ $staged_file has a todo!() statement.\n"
          todo_found=1
        }
    fi
  done < "$STAGED_FILES"

  if [[ -z $todo_found ]] && [[ -n $rust_found ]]; then
    PASS_MSGS="${PASS_MSGS}✅ No 'todo!()' statements.\n"
  fi
}

run_extra_hooks() {
  [[ -e "$HOOK_DIR/pre-commit-extras" ]] || return 0

  source "$HOOK_DIR/pre-commit-extras"
}

die() {
  echo "ERROR: $*"
  exit 1
}

do_or_die() {
  "$@" || die "Command failed: '$*'"
}

go_no_go() {
  # Did we fail any checks?
  if [[ -n ${FAIL_MSGS} ]]; then
    echo -e "One or more pre-commit checks failed."
  fi

  echo -en "$FAIL_MSGS"
  echo -en "$PASS_MSGS"

  # Did we fail any checks?
  if [[ -n ${FAIL_MSGS} ]]; then
    echo -e "\nRemember that if you fix something, you need to stage the fix via 'git add' before committing again."
    exit 1
  fi

  echo "pre-commit: ✅ All tests pass."
}

cleanup() {
  rm "$STAGED_FILES" >& /dev/null
  rm "$RENAMED_FILES" >& /dev/null
}

main
